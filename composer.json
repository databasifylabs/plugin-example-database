{
    "name": "databasifylabs/plugin-example-database",
    "description": "Example Databasify plugin: a small SQLite engine with its own driver and flat scripts, for engine authors to copy.",
    "version": "3.0.1",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Databasify",
            "homepage": "https://github.com/databasifylabs"
        }
    ],
    "autoload": {
        "psr-4": {
            "Databasify\\ExampleDatabase\\": "src/"
        }
    },
    "extra": {
        "databasify": {
            "plugin": "Databasify\\ExampleDatabase\\ExampleDatabasePlugin",
            "requires": "^0.2",
            "icon": "icon.svg",
            "engines": [
                "example"
            ]
        }
    }
}
